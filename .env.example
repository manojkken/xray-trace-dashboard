# AWS profile with X-Ray read access (xray:GetTraceSummaries)
AWS_PROFILE=your-profile-name

# AWS region your X-Ray traces live in
AWS_REGION=eu-central-1

# Optional: exact hostname suffix to classify as "prod" (e.g. yourcompany.com).
# Leave unset to rely solely on the *.prod.* hostname convention.
PROD_DOMAIN_SUFFIX=

# Port the dashboard server listens on (default: 3000)
PORT=3000
